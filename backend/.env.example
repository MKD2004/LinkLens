# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/linklens

# Auth
JWT_SECRET=<run: node -e "require('crypto').randomBytes(32).toString('hex')">

# Redis
REDIS_URL=redis://:<password>@<host>:<port>

# CORS and URLs
ALLOWED_ORIGINS=http://localhost:5173
BASE_URL=http://localhost:3000
